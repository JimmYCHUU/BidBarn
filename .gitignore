# Environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets and sessions: never committed
.env
*.har
har/

# Runtime data: browser profile (cookies), SQLite, downloaded sheets/photos, page cache, logs
data/
*.sqlite
*.log

# Fetched bidding guides (full Carbarn bid grids) and standing instructions are operational data
rules/snapshots/*
!rules/snapshots/.gitkeep
rules/overrides/*
!rules/overrides/.gitkeep
rules/playbook/*
!rules/playbook/.gitkeep

# Build metadata
*.egg-info/

# Browser tool snapshots (page content), never committed
.playwright-mcp/

# Design review captures and decision-page logs (the surface briefs under .impeccable/surfaces are kept)
.impeccable/review/
.impeccable/questions/
.impeccable/config.local.json
